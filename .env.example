# PayPal sandbox REST app (never live keys)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Channel3
CHANNEL3_API_KEY=
# LLM (vision, reasons, and the Decisions workspace's agents)
ANTHROPIC_API_KEY=
# AG Studio licence key for /studio (read at build time)
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
# Sandbox failure simulation (PayPal-Mock-Response); leave unset outside demos
DEMO_NEGATIVE_TESTING=
# Fill the shelf from PayPal activity (needs Transaction Search on the PayPal app)
SHELF_IMPORT_PAYPAL=
# Channel3 webhook signing secret (whsec_...) for /api/webhooks/channel3
CHANNEL3_WEBHOOK_SECRET=
# Where shopper sessions, the event log and caches are written (default .data/)
APP_DATA_DIR=
# Public URL, if the forwarded host headers are not enough
APP_BASE_URL=
