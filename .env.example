# PayPal sandbox REST app (never live keys)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Channel3
CHANNEL3_API_KEY=
# LLM (vision, reasons, and the Decisions workspace's agents)
ANTHROPIC_API_KEY=
# AG Studio licence key for /studio (read at build time)
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
# Sandbox failure simulation (PayPal-Mock-Response); leave unset outside demos
DEMO_NEGATIVE_TESTING=
# Fill the shelf from PayPal activity (needs Transaction Search on the PayPal app)
SHELF_IMPORT_PAYPAL=
# Channel3 webhook signing secret (whsec_...) for /api/webhooks/channel3
CHANNEL3_WEBHOOK_SECRET=
# Where shopper sessions, the event log and caches are written (default .data/)
APP_DATA_DIR=
# Public URL, if the forwarded host headers are not enough
APP_BASE_URL=
# Signs the shopper session cookie (any long random string; keep it secret, e.g. `openssl rand -base64 32`)
SESSION_SECRET=
# Limits (optional; defaults shown). Assistant calls across all shoppers per hour, and output tokens per call
LLM_CALLS_PER_HOUR=600
LLM_MAX_TOKENS=4096
# Assistant calls per shopper session in 10 minutes
STUDIO_CALLS_PER_10_MIN=80
# New screenshots or links checked (each a vision call), per shopper per hour and across all shoppers per hour
CHECKS_PER_SESSION_PER_HOUR=30
CHECKS_PER_HOUR=300
